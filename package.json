{
  "$schema": "https://json.schemastore.org/package",
  "name": "pi-telegram-plus",
  "version": "0.0.12",
  "description": "Full Telegram control of pi coding agent \u2014 commands, menus, interactive UI, model management, and more",
  "keywords": [
    "pi-package",
    "pi-extension",
    "telegram",
    "coding-agent",
    "remote-control"
  ],
  "license": "MIT",
  "author": "jalyfeng",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "lib/**/*.ts",
    "!lib/__tests__/",
    "CHANGELOG.md",
    "docs/compatibility.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e/run-e2e.mjs",
    "test:e2e:omp": "node scripts/e2e/run-e2e-omp.mjs",
    "test:e2e:tui-bridge": "node scripts/e2e/run-e2e-tui-bridge.mjs",
    "test:e2e:commands": "node scripts/e2e/run-e2e-commands.mjs",
    "test:e2e:dialogs": "node scripts/e2e/run-e2e-dialogs.mjs",
    "test:e2e:state": "node scripts/e2e/run-e2e-state.mjs",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "changelog:roll": "node scripts/changelog-version.mjs",
    "changelog:check": "node scripts/changelog-version.mjs --check",
    "prepublishOnly": "npm test && npm run typecheck && npm run changelog:check",
    "test:e2e:real": "node scripts/e2e/real-telegram-smoke.mjs",
    "test:e2e:parity": "node scripts/e2e/audit-parity.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://pi.dev/logo-auto.svg",
    "video": ""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jalyfeng/pi-telegram-plus"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@earendil-works/pi-coding-agent": "1.4.0"
  }
}
